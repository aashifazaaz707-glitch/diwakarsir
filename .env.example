# Groq API Key for the AI Chatbot
# Get a free API key from https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Google Sheets Web App URL for parent lead storage
# Get this by deploying a Google Apps Script as a Web App
VITE_GOOGLE_SHEETS_URL=your_google_sheets_web_app_url_here

# Google Sheets Web App URL for tutor registration storage
# Get this by deploying a Google Apps Script as a Web App
VITE_GOOGLE_SHEETS_TUTOR_URL=your_tutor_google_sheets_web_app_url_here
